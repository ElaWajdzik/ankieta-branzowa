    "# Porównujemy respondentów, którzy pracują dokładnie w wybranym modelu,\n",
    "# z osobami, które deklarują inny model niż obecny.\n",
    "d = a.dropna(subset=[\"model\", \"preferowany\"]).copy()\n",
    "d[\"dopasowanie\"] = np.where(d[\"model\"] == d[\"preferowany\"],\n",
    "                             \"Zgodny\", \"Niezgodny\")\n",
    "zgodnosc = d.groupby(\"dopasowanie\").agg(\n",
    "    n=(\"id\", \"size\"),\n",
    "    n_satysfakcja=(\"satysfakcja\", \"count\"),\n",
    "    satysfakcja=(\"satysfakcja\", \"mean\"),\n",
    "    n_wlb=(\"wlb\", \"count\"),\n",
    "    wlb=(\"wlb\", \"mean\")\n",
    ").reindex([\"Niezgodny\", \"Zgodny\"])\n",
    "display(zgodnosc.round(2))\n",
    "\n",
    "ax = zgodnosc[[\"satysfakcja\", \"wlb\"]].rename(columns={\n",
    "    \"satysfakcja\": \"Satysfakcja z pracy\", \"wlb\": \"Work-life balance\"\n",
    "}).plot(kind=\"barh\", figsize=(9, 3.6))\n",
    "ax.set(xlabel=\"Średnia ocena (skala 1–10)\", ylabel=\"Model a preferencje\",\n",
    "       title=\"Czy dopasowanie sposobu pracy wiąże się z wyższymi ocenami?\")\n",
    "ax.set_xlim(0, 10)\n",
    "for bars in ax.containers:\n",
    "    ax.bar_label(bars, fmt=\"%.2f\", padding=3, fontsize=9)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Sprawdzenie wewnątrz najliczniejszych grup seniority\n",
    "kontrola = d[d[\"seniority\"].isin([\"junior\", \"mid / regular\", \"senior\"])]\n",
    "kontrola_wynik = kontrola.groupby([\"seniority\", \"dopasowanie\"])[\"satysfakcja\"].agg(\n",
    "    n=\"count\", srednia=\"mean\"\n",
    ").round(2)\n",
    "print(\"Kontrola według seniority:\")\n",
    "display(kontrola_wynik)"
   ]
