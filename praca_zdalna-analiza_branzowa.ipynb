   "source": [
    "def zestawienie_grup(kolumna):\n",
    "    d = a.dropna(subset=[kolumna, \"model\", \"preferowany\"])\n",
    "    t = d.groupby(kolumna).agg(\n",
    "        n=(\"id\", \"size\"),\n",
    "        pracuje_zdalnie=(\"pracuje_zdalnie\", \"mean\"),\n",
    "        chce_zdalnie=(\"chce_zdalnie\", \"mean\")\n",
    "    )\n",
    "    t[[\"pracuje_zdalnie\", \"chce_zdalnie\"]] *= 100\n",
    "    t[\"luka_pp\"] = t[\"chce_zdalnie\"] - t[\"pracuje_zdalnie\"]\n",
    "    return t.round(1)\n",
    "\n",
    "sen = zestawienie_grup(\"seniority\")\n",
    "role = zestawienie_grup(\"stanowisko\")\n",
    "forma = zestawienie_grup(\"zatrudnienie\")\n",
    "\n",
    "print(\"SENIORITY (najważniejsze trzy poziomy)\")\n",
    "trzy = [\"junior\", \"mid / regular\", \"senior\"]\n",
    "display(sen.reindex(trzy))\n",
    "\n",
    "ax = sen.reindex(trzy)[[\"pracuje_zdalnie\", \"chce_zdalnie\"]].rename(columns={\n",
    "    \"pracuje_zdalnie\": \"Pracuje zdalnie\", \"chce_zdalnie\": \"Chce zdalnie\"\n",
    "}).plot(kind=\"barh\", figsize=(9, 4))\n",
    "ax.set(xlabel=\"Odsetek respondentów (%)\", ylabel=\"Seniority\",\n",
    "       title=\"Pełna zdalność i preferencje: juniorzy, midzi, seniorzy\")\n",
    "ax.set_xlim(0, 100)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"STANOWISKA (wszystkie kategorie, interpretuj z kolumną n)\")\n",
    "display(role.sort_values(\"pracuje_zdalnie\", ascending=False))\n",
    "\n",
    "print(\"FORMA ZATRUDNIENIA\")\n",
    "display(forma.sort_values(\"pracuje_zdalnie\", ascending=False))\n",
    "\n",
    "# Najważniejsze porównanie form zatrudnienia: B2B vs umowa o pracę\n",
    "kluczowe = [\"b2b (samozatrudnienie)\", \"umowa o pracę\"]\n",
    "ax = forma.reindex(kluczowe)[[\"pracuje_zdalnie\", \"chce_zdalnie\"]].rename(columns={\n",
    "    \"pracuje_zdalnie\": \"Pracuje zdalnie\", \"chce_zdalnie\": \"Chce zdalnie\"\n",
    "}).plot(kind=\"barh\", figsize=(9, 3.5))\n",
    "ax.set(xlabel=\"Odsetek respondentów (%)\", ylabel=\"Forma zatrudnienia\",\n",
    "       title=\"Praca w pełni zdalna: B2B vs umowa o pracę\")\n",
    "ax.set_xlim(0, 100)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
