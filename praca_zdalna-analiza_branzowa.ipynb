   "source": [
    "# Rozkład obecnych modeli pracy\n",
    "rozklad = a[\"model\"].value_counts().reindex(modele, fill_value=0)\n",
    "rozklad_pct = (rozklad / rozklad.sum() * 100).round(1)\n",
    "display(pd.DataFrame({\"liczba\": rozklad, \"udział_%\": rozklad_pct}))\n",
    "\n",
    "# Jak chcą pracować osoby z poszczególnych obecnych modeli?\n",
    "przejscia_n = pd.crosstab(a[\"model\"], a[\"preferowany\"])\n",
    "przejscia_n = przejscia_n.reindex(index=modele, columns=modele, fill_value=0)\n",
    "przejscia_pct = przejscia_n.div(przejscia_n.sum(axis=1), axis=0).mul(100)\n",
    "\n",
    "display(przejscia_pct.round(1))\n",
    "ax = przejscia_pct.plot(kind=\"barh\", stacked=True, figsize=(10, 5))\n",
    "ax.set(xlabel=\"Odsetek w ramach obecnego modelu (%)\", ylabel=\"Obecny model\",\n",
    "       title=\"Jak chcemy pracować? Preferencje według obecnego modelu\")\n",
    "ax.set_xlim(0, 100)\n",
    "ax.legend(title=\"Preferowany model\", bbox_to_anchor=(1.02, 1), loc=\"upper left\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
