    "def znajdz_kolumne(fragment):\n",
    "    pasujace = [c for c in data.columns if fragment.casefold() in c.casefold()]\n",
    "    if len(pasujace) != 1:\n",
    "        raise ValueError(f\"Dla {fragment!r} znaleziono: {pasujace}\")\n",
    "    return pasujace[0]\n",
    "\n",
    "def tekst(s):\n",
    "    return (s.astype(\"string\")\n",
    "             .str.replace(r\"\\s+\", \" \", regex=True)\n",
    "             .str.strip().str.lower())\n",
    "\n",
    "def ocena_num(s):\n",
    "    return pd.to_numeric(tekst(s).str.replace(\",\", \".\", regex=False), errors=\"coerce\")\n",
    "\n",
    "k = {\n",
    "    \"model\": znajdz_kolumne(\"w jakim modelu pracujesz na co dzień\"),\n",
    "    \"preferowany\": znajdz_kolumne(\"jak chciał(a)byś pracować na co dzień\"),\n",
    "    \"stanowisko\": znajdz_kolumne(\"__stanowisko\"),\n",
    "    \"seniority\": znajdz_kolumne(\"poziom stanowiska (seniority)\"),\n",
    "    \"zatrudnienie\": znajdz_kolumne(\"w jakiej formie jesteś obecnie zatrudnion\"),\n",
    "    \"satysfakcja\": znajdz_kolumne(\"zadowolona/y ze swojej pracy\"),\n",
    "    \"wlb\": znajdz_kolumne(\"równowagę między pracą a życiem prywatnym\"),\n",
    "    \"godziny\": znajdz_kolumne(\"ile godzin dziennie średnio pracujesz\"),\n",
    "    \"wymiar\": znajdz_kolumne(\"__wymiar pracy\"),\n",
    "}\n",
    "\n",
    "a = pd.DataFrame({\n",
    "    \"id\": data[\"id\"],\n",
    "    \"model\": tekst(data[k[\"model\"]]),\n",
    "    \"preferowany\": tekst(data[k[\"preferowany\"]]),\n",
    "    \"stanowisko\": tekst(data[k[\"stanowisko\"]]),\n",
    "    \"seniority\": tekst(data[k[\"seniority\"]]),\n",
    "    \"zatrudnienie\": tekst(data[k[\"zatrudnienie\"]]),\n",
    "    \"satysfakcja\": ocena_num(data[k[\"satysfakcja\"]]),\n",
    "    \"wlb\": ocena_num(data[k[\"wlb\"]]),\n",
    "    \"godziny\": tekst(data[k[\"godziny\"]]).str.replace(\"–\", \"-\", regex=False),\n",
    "    \"wymiar\": tekst(data[k[\"wymiar\"]]),\n",
    "})\n",
    "\n",
    "a[\"pracuje_zdalnie\"] = a[\"model\"].eq(\"zdalnie\")\n",
    "a[\"chce_zdalnie\"] = a[\"preferowany\"].eq(\"zdalnie\")\n",
    "\n",
    "print(\"Odpowiedzi na pytania kluczowe:\")\n",
    "display(a[[\"model\", \"preferowany\", \"satysfakcja\", \"wlb\"]].notna().sum().to_frame(\"n\"))\n",
    "\n",
    "# Przydatna kolejność kategorii na wykresach\n",
    "modele = [\n",
    "    \"stacjonarnie\",\n",
    "    \"hybrydowo - większość z biura\",\n",
    "    \"hybrydowo - większość z domu\",\n",
    "    \"zdalnie\",\n",
    "]"
   ]
