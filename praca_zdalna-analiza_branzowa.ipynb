    "# Uczciwe porównanie czasu pracy: tylko pełny etat i ważne odpowiedzi\n",
    "full = a[\n",
    "    a[\"wymiar\"].str.startswith(\"pełny etat\", na=False)\n",
    "    & a[\"model\"].notna()\n",
    "    & a[\"godziny\"].notna()\n",
    "].copy()\n",
    "\n",
    "# W danych odpowiedź „więcej” oznacza ponad 10 godzin.\n",
    "# Normalizacja zapisu „9–10” -> „9-10”.\n",
    "full[\"godziny_std\"] = (full[\"godziny\"]\n",
    "    .str.replace(\"—\", \"-\", regex=False)\n",
    "    .str.replace(r\"\\s*-\\s*\", \"-\", regex=True))\n",
    "\n",
    "kategorie_godzin = [\n",
    "    \"mniej niż 6 godzin\", \"6-7 godzin\", \"8 godzin\", \"9-10 godzin\", \"więcej\"\n",
    "]\n",
    "nieznane = full.loc[~full[\"godziny_std\"].isin(kategorie_godzin), \"godziny_std\"].unique()\n",
    "if len(nieznane):\n",
    "    raise ValueError(f\"Nieznane kategorie czasu pracy: {nieznane}\")\n",
    "\n",
    "full[\"dlugi_dzien\"] = full[\"godziny_std\"].isin([\"9-10 godzin\", \"więcej\"])\n",
    "\n",
    "def mediana_kategorii(s):\n",
    "    indeksy = sorted(kategorie_godzin.index(v) for v in s.dropna())\n",
    "    n = len(indeksy)\n",
    "    if not n:\n",
    "        return \"brak\"\n",
    "    left, right = kategorie_godzin[indeksy[(n-1)//2]], kategorie_godzin[indeksy[n//2]]\n",
    "    return left if left == right else f\"między {left} a {right}\"\n",
    "\n",
    "czas = full.groupby(\"model\").agg(\n",
    "    liczba_osob=(\"id\", \"size\"),\n",
    "    dni_9h_plus=(\"dlugi_dzien\", \"sum\"),\n",
    "    odsetek_9h_plus=(\"dlugi_dzien\", \"mean\"),\n",
    "    mediana=(\"godziny_std\", mediana_kategorii)\n",
    ").reindex(modele)\n",
    "czas[\"odsetek_9h_plus\"] *= 100\n",
    "display(czas.round(1))\n",
    "\n",
    "ax = czas[\"odsetek_9h_plus\"].plot(kind=\"barh\", figsize=(9, 4))\n",
    "ax.set(xlabel=\"Odsetek osób (%)\", ylabel=\"Model pracy\",\n",
    "       title=\"Długie dni pracy (≥9 h) — wyłącznie pełny etat\")\n",
    "ax.set_xlim(0, max(35, czas[\"odsetek_9h_plus\"].max()*1.3))\n",
    "for i, value in enumerate(czas[\"odsetek_9h_plus\"]):\n",
    "    ax.text(value + 0.5, i, f\"{value:.1f}%\", va=\"center\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
